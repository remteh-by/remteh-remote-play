--- /dev/null
+++ b/gui/src/qml/DeckButton.qml
@@ -0,0 +1,27 @@
+import QtQuick
+import QtQuick.Controls
+
+Button {
+    id: button
+    property bool primary: false
+    implicitHeight: 42
+    leftPadding: 17
+    rightPadding: 17
+    hoverEnabled: true
+    contentItem: Text {
+        text: button.text
+        font.family: button.font.family
+        font.pixelSize: 15
+        font.weight: Font.DemiBold
+        color: !button.enabled ? "#919AA6" : button.primary ? "#17200A" : "#F3F5F7"
+        verticalAlignment: Text.AlignVCenter
+        horizontalAlignment: Text.AlignHCenter
+        elide: Text.ElideRight
+    }
+    background: Rectangle {
+        radius: 12
+        color: !button.enabled ? "#282D32" : button.primary ? (button.hovered ? "#E6FFA0" : "#DAF975") : (button.hovered ? "#343B44" : "#222730")
+        border.color: button.visualFocus ? "#FFFFFF" : button.primary && button.enabled ? "#DAF975" : "#404853"
+        border.width: button.visualFocus ? 2 : 1
+    }
+}
