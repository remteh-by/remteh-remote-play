+bool QmlMainWindow::desktopEvent(QEvent *event)
+{
+    if (!tools || !session || grab_input) return false;
+    const auto type = event->type();
+    if (type == QEvent::FocusOut || type == QEvent::WindowDeactivate) {
+        releaseDesktopInput();
+        return false;
+    }
+    if (type == QEvent::KeyPress || type == QEvent::KeyRelease) {
+        auto key = static_cast<QKeyEvent *>(event);
+        const bool down = type == QEvent::KeyPress;
+        if (key->key() == Qt::Key_F8 && key->modifiers() == Qt::NoModifier) {
+            if (!down || key->isAutoRepeat()) return true;
+            if (capturing_mouse) releaseDesktopInput();
+            else if (settings->GetKeyboardEnabled() && setMouseGrabEnabled(true)) {
+                capturing_mouse = true;
+                setCursor(Qt::BlankCursor);
+                QCursor::setPos(mapToGlobal(QPoint(width()/2,height()/2)));
+            }
+            return true;
+        }
+        if (!capturing_mouse) return false;
+        if (key->key() == Qt::Key_Escape) {
+            if (down) releaseDesktopInput();
+            return true;
+        }
+        if (key->key() == Qt::Key_W || key->key() == Qt::Key_A || key->key() == Qt::Key_S || key->key() == Qt::Key_D) {
+            if (!key->isAutoRepeat()) {
+                if (down) desktop_input.keys.insert(key->key());
+                else desktop_input.keys.remove(key->key());
+                sendDesktopInput();
+            }
+            return true;
+        }
+        return false;
+    }
+    if (type == QEvent::TouchCancel) {
+        desktop_input.contacts.clear(); sendDesktopInput(); return false;
+    }
+    if (type == QEvent::TouchBegin || type == QEvent::TouchUpdate || type == QEvent::TouchEnd) {
+        if (!tools->touchOverlay()) return false;
+        for (const auto &point : static_cast<QTouchEvent *>(event)->points()) {
+            if (point.state() == QEventPoint::Released) desktop_input.contacts.remove(point.id());
+            else desktop_input.contact(point.id(), point.position(), size(), point.state() == QEventPoint::Pressed);
+        }
+        sendDesktopInput();
+        return true;
+    }
+    if (type != QEvent::MouseMove && type != QEvent::MouseButtonPress && type != QEvent::MouseButtonRelease && type != QEvent::MouseButtonDblClick)
+        return false;
+    auto mouse = static_cast<QMouseEvent *>(event);
+    if (mouse->source() != Qt::MouseEventNotSynthesized) return false;
+    if (!capturing_mouse) {
+        // A click on the overlay also works on a non-touch monitor.
+        constexpr int pointer = -1;
+        if (!tools->touchOverlay()) return false;
+        if (type == QEvent::MouseButtonPress && mouse->button() == Qt::LeftButton)
+            desktop_input.contact(pointer, mouse->position(), size(), true);
+        if (!desktop_input.contacts.contains(pointer)) return false;
+        if (type == QEvent::MouseButtonRelease) desktop_input.contacts.remove(pointer);
+        else desktop_input.contact(pointer, mouse->position(), size(), false);
+        sendDesktopInput();
+        return true;
+    }
+    if (type == QEvent::MouseMove) {
+        const QPoint center(width()/2,height()/2);
+        auto delta = mouse->position().toPoint() - center;
+        if (delta.isNull()) return true;
+        const int scale = tools->sensitivity() * 12;
+        desktop_input.aim = {qBound(-32767,delta.x()*scale,32767),
+            qBound(-32767,delta.y()*scale*(tools->invert() ? -1 : 1),32767)};
+        QCursor::setPos(mapToGlobal(center));
+        aim_timer.start(45);
+    } else {
+        const QList<Qt::MouseButton> buttons{Qt::LeftButton,Qt::RightButton,Qt::MiddleButton,Qt::BackButton,Qt::ForwardButton};
+        const int index = buttons.indexOf(mouse->button());
+        if (index < 0) return true;
+        if (type == QEvent::MouseButtonRelease) desktop_input.mouseButtons.remove(index);
+        else desktop_input.mouseButtons[index] = tools->mouseActions().at(index).toInt();
+    }
+    sendDesktopInput();
+    return true;
+}
