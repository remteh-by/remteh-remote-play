<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/deckivo_background">
<com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="60dp" app:navigationIcon="@drawable/ic_deckivo_back" app:navigationContentDescription="@string/dv_back" app:title="deckivo" />
<TextView android:id="@+id/titleTextView" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="28dp" android:paddingEnd="28dp" android:paddingTop="8dp" android:paddingBottom="12dp" android:text="@string/title_settings" android:textSize="30sp" android:fontFamily="sans-serif-medium" />
<com.google.android.material.tabs.TabLayout android:id="@+id/settingsTabs" android:layout_width="match_parent" android:layout_height="52dp" app:tabMode="scrollable" app:tabGravity="start" app:tabTextColor="@color/deckivo_muted" app:tabSelectedTextColor="@color/accent" app:tabIndicatorColor="@color/accent" android:background="@color/deckivo_bg" />
<FrameLayout android:id="@+id/settingsFragment" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingStart="12dp" android:paddingEnd="12dp" />
</LinearLayout>