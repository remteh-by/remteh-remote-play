<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/rootLayout" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:background="@color/deckivo_bg">
  <LinearLayout android:layout_width="76dp" android:layout_height="match_parent" android:orientation="vertical" android:padding="10dp" android:background="@color/deckivo_rail">
    <ImageView android:layout_width="48dp" android:layout_height="58dp" android:src="@drawable/ic_deckivo" android:importantForAccessibility="no" />
    <com.google.android.material.button.MaterialButton android:id="@+id/navPlay" style="@style/Deckivo.Button.Secondary" android:layout_width="match_parent" android:layout_height="48dp" android:text="" android:maxLines="2" app:icon="@drawable/ic_deckivo_play" app:iconSize="20dp" android:contentDescription="@string/dv_play" android:layout_marginTop="8dp" android:paddingStart="8dp" android:paddingEnd="8dp" app:iconPadding="0dp" app:iconGravity="textStart" />
    <com.google.android.material.button.MaterialButton android:id="@+id/navSetup" style="@style/Deckivo.Button.Secondary" android:layout_width="match_parent" android:layout_height="48dp" android:text="" android:maxLines="2" app:icon="@drawable/ic_deckivo_link" app:iconSize="20dp" android:contentDescription="@string/dv_controller" android:layout_marginTop="8dp" android:paddingStart="8dp" android:paddingEnd="8dp" app:iconPadding="0dp" app:iconGravity="textStart" />
    <com.google.android.material.button.MaterialButton android:id="@+id/navUpdates" style="@style/Deckivo.Button.Secondary" android:layout_width="match_parent" android:layout_height="48dp" android:text="" android:maxLines="2" app:icon="@drawable/ic_log" app:iconSize="20dp" android:contentDescription="@string/dv_sessions" android:layout_marginTop="8dp" android:paddingStart="8dp" android:paddingEnd="8dp" app:iconPadding="0dp" app:iconGravity="textStart" />
    <com.google.android.material.button.MaterialButton android:id="@+id/navSettings" style="@style/Deckivo.Button.Secondary" android:layout_width="match_parent" android:layout_height="48dp" android:text="" android:maxLines="2" app:icon="@drawable/ic_settings" app:iconSize="20dp" android:contentDescription="@string/dv_settings" android:layout_marginTop="8dp" android:paddingStart="8dp" android:paddingEnd="8dp" app:iconPadding="0dp" app:iconGravity="textStart" />
    <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="12sp" android:fontFamily="@font/ibm_plex_sans" android:textColor="@color/deckivo_muted" android:id="@+id/buildVersion" />
  </LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:layout_marginStart="76dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:orientation="horizontal" android:baselineAligned="false">
      <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/dv_room" android:textSize="26sp" android:fontFamily="@font/ibm_plex_sans" android:textColor="@color/deckivo_text" android:layout_weight="1" />
      <com.google.android.material.button.MaterialButton android:id="@+id/languageButton" style="@style/Deckivo.Button.Secondary" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/dv_language" android:contentDescription="@string/dv_language" android:textSize="12sp" />
      <com.google.android.material.button.MaterialButton android:id="@+id/addConsoleButton" style="@style/Deckivo.Button.Secondary" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@string/dv_add" app:icon="@drawable/ic_add" app:iconSize="20dp" app:iconPadding="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:layout_marginStart="6dp" />
      <com.google.android.material.button.MaterialButton android:id="@+id/updatesButton" style="@style/Deckivo.Button.Secondary" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@string/dv_updates" app:icon="@drawable/ic_log" app:iconSize="20dp" app:iconPadding="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" android:layout_marginStart="6dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical" android:baselineAligned="false">
      <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/dv_consoles_network" android:textSize="12sp" android:fontFamily="@font/ibm_plex_sans" android:textColor="@color/deckivo_muted" android:id="@+id/libraryStatus" android:layout_weight="1" />
      <com.google.android.material.button.MaterialButton android:id="@+id/discoveryButton" style="@style/Deckivo.Button.Secondary" android:layout_width="wrap_content" android:layout_height="40dp" android:text="@string/dv_discovery_on" android:textSize="12sp" app:icon="@drawable/ic_discover_on" app:iconSize="16dp" />
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
      <FrameLayout android:layout_width="0dp" android:layout_height="0dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toStartOf="@id/columnsGuideline">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/hostsRecyclerView" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingTop="10dp" android:paddingBottom="12dp" />
        <LinearLayout android:id="@+id/emptyInfoLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:orientation="vertical" android:padding="20dp" android:background="@drawable/deckivo_panel">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/dv_empty_title" android:textSize="22sp" android:fontFamily="@font/ibm_plex_sans" android:textColor="@color/deckivo_text" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/dv_empty_intro" android:textSize="14sp" android:fontFamily="@font/ibm_plex_sans" android:textColor="@color/deckivo_muted" android:id="@+id/emptyInfoTextView" android:layout_marginTop="12dp" />
        </LinearLayout>
      </FrameLayout>
      <ScrollView android:layout_width="0dp" android:layout_height="0dp" android:layout_marginStart="14dp" android:scrollbars="none" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="@id/columnsGuideline" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="10dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp" android:background="@drawable/deckivo_panel">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/dv_quality" android:textSize="17sp" android:fontFamily="@font/ibm_plex_sans" android:textColor="@color/deckivo_text" />
            <com.google.android.material.button.MaterialButton android:id="@+id/qualityFast" style="@style/Deckivo.Button.Secondary" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/dv_quality_smooth" android:maxLines="2" android:textSize="12sp" android:layout_marginTop="8dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/qualityBalanced" style="@style/Deckivo.Button.Secondary" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/dv_quality_balanced" android:maxLines="2" android:textSize="12sp" android:layout_marginTop="6dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/qualitySafe" style="@style/Deckivo.Button.Secondary" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/dv_quality_safe" android:maxLines="2" android:textSize="12sp" android:layout_marginTop="6dp" />
      <com.google.android.material.button.MaterialButton android:id="@+id/qualitySharp" style="@style/Deckivo.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/dv_quality_sharp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/dv_requested_fps" android:textSize="12sp" android:fontFamily="@font/ibm_plex_sans" android:textColor="@color/deckivo_muted" android:layout_marginTop="8dp" />
          </LinearLayout>
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp" android:background="@drawable/deckivo_panel" android:layout_marginTop="12dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/dv_controller" android:textSize="17sp" android:fontFamily="@font/ibm_plex_sans" android:textColor="@color/deckivo_text" />
            <com.google.android.material.button.MaterialButton android:id="@+id/controllerTestButton" style="@style/Deckivo.Button.Secondary" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/dv_test_controller" android:maxLines="2" android:layout_marginTop="8dp" android:textSize="12sp" />
          </LinearLayout>
        </LinearLayout>
      </ScrollView>
      <androidx.constraintlayout.widget.Guideline android:id="@+id/columnsGuideline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" app:layout_constraintGuide_percent="0.66" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/dv_update_ready" android:textSize="13sp" android:fontFamily="@font/ibm_plex_sans" android:textColor="@color/accent" android:id="@+id/updateStatus" android:visibility="gone" android:clickable="true" android:focusable="true" android:minHeight="44dp" android:gravity="center_vertical" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:baselineAligned="false">
      <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/dv_developer_credit" android:textSize="12sp" android:fontFamily="@font/ibm_plex_sans" android:textColor="@color/deckivo_muted" android:id="@+id/developerCredit" android:layout_weight="1" android:clickable="true" android:focusable="true" android:minHeight="44dp" android:gravity="center_vertical" />
      <com.google.android.material.button.MaterialButton android:id="@+id/supportButton" style="@style/Deckivo.Button.Secondary" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/dv_support_link" android:maxLines="2" android:contentDescription="@string/dv_support" android:layout_marginStart="8dp" />
    </LinearLayout>
  </LinearLayout>
</FrameLayout>